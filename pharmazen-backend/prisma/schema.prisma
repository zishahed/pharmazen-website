generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  pharmacist
  admin
}

enum PrescriptionStatus {
  pending
  approved
  rejected
}

enum OrderStatus {
  pending
  awaiting_prescription
  paid
  cancelled
}

enum PaymentStatus {
  unpaid
  paid
  failed
}

enum PaymentRecordStatus {
  initiated
  completed
  failed
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(customer)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens         RefreshToken[]
  prescriptions         Prescription[]
  orders                Order[]
  cart                  Cart?
  reviewedPrescriptions Prescription[] @relation("ReviewedBy")

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @unique
  medicines Medicine[]

  @@map("categories")
}

model Medicine {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  description          String?
  categoryId           String    @map("category_id") @db.Uuid
  price                Decimal   @db.Decimal(10, 2)
  stockQuantity        Int       @map("stock_quantity")
  expiryDate           DateTime? @map("expiry_date") @db.Date
  requiresPrescription Boolean   @default(false) @map("requires_prescription")
  createdAt            DateTime  @default(now()) @map("created_at")

  // ── Sync columns (Phase 1A) ──────────────────────────────────────────────
  // generic_id mirrors the app's SQLite `generics.generic_id`, so the mobile
  // client can resolve a brand -> generic FK without string matching.
  genericId        Int?     @map("generic_id")
  slug             String?
  type             String?
  dosageForm       String?  @map("dosage_form")
  strength         String?
  manufacturer     String?
  // package_container is informational only: price is NOT synced, and the
  // client keeps its own local copy of the packaged string.
  packageContainer String?  @map("package_container")
  packageSize      String?  @map("package_size")
  isSensitive      Boolean  @default(false) @map("is_sensitive")
  // updated_at is the ?since= cursor for /api/sync. @default(now()) is
  // required so pre-existing rows get a non-null bootstrap value.
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  // Phase 1B: deleteMedicine flips this flag instead of removing the row, so a
  // `?since=` cursor can observe a deletion. Restore via
  // POST /api/admin/medicines/:id/restore.
  isDeleted        Boolean  @default(false) @map("is_deleted")

  category   Category    @relation(fields: [categoryId], references: [id])
  generic    Generic?    @relation(fields: [genericId], references: [genericId])
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([genericId])
  @@index([updatedAt])
  // Phase 2: composite index behind /api/sync keyset paging. Additive — the
  // single-column updatedAt index is left in place rather than replaced, so
  // this phase drops nothing. See prisma/phase2-sync-indexes.sql.
  @@index([updatedAt, id])
  @@map("medicines")
}

model Generic {
  // Phase 3: sequence-backed so an admin creating a generic does not have to
  // hand-pick a unique integer. Requires prisma/phase3-generics-autoincrement.sql.
  genericId                        Int      @id @default(autoincrement()) @map("generic_id")
  genericName                      String   @unique @map("generic_name")
  slug                             String?
  monographLink                    String?  @map("monograph_link")
  drugClass                        String?  @map("drug_class")
  indication                       String?
  indicationDescription            String?  @map("indication_description")
  therapeuticClassDescription      String?  @map("therapeutic_class_description")
  pharmacologyDescription          String?  @map("pharmacology_description")
  dosageDescription                String?  @map("dosage_description")
  administrationDescription        String?  @map("administration_description")
  interactionDescription           String?  @map("interaction_description")
  contraindicationsDescription     String?  @map("contraindications_description")
  sideEffectsDescription           String?  @map("side_effects_description")
  pregnancyAndLactationDescription String?  @map("pregnancy_and_lactation_description")
  precautionsDescription           String?  @map("precautions_description")
  pediatricUsageDescription        String?  @map("pediatric_usage_description")
  overdoseEffectsDescription       String?  @map("overdose_effects_description")
  durationOfTreatmentDescription   String?  @map("duration_of_treatment_description")
  reconstitutionDescription        String?  @map("reconstitution_description")
  storageConditionsDescription     String?  @map("storage_conditions_description")
  descriptionsCount                Int      @default(0) @map("descriptions_count")
  createdAt                        DateTime @default(now()) @map("created_at")
  updatedAt                        DateTime @default(now()) @updatedAt @map("updated_at")
  isDeleted                        Boolean  @default(false) @map("is_deleted")

  medicines Medicine[]

  @@index([drugClass])
  @@index([indication])
  @@index([updatedAt])
  // Phase 2: composite index behind /api/sync keyset paging. See medicines.
  @@index([updatedAt, genericId])
  @@map("generics")
}

model Prescription {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  medicineId   String             @map("medicine_id") @db.Uuid
  medicineName String             @map("medicine_name")
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime           @map("end_date") @db.Date
  comment      String?
  status       PrescriptionStatus @default(pending)
  reviewedBy   String?            @map("reviewed_by") @db.Uuid
  reviewNote   String?            @map("review_note")
  createdAt    DateTime           @default(now()) @map("created_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?              @relation("ReviewedBy", fields: [reviewedBy], references: [id])
  orders   Order[]
  files    PrescriptionFile[]

  @@index([userId])
  @@map("prescriptions")
}

model PrescriptionFile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prescriptionId String   @map("prescription_id") @db.Uuid
  fileUrl        String   @map("file_url")
  cloudinaryId   String   @map("cloudinary_public_id")
  createdAt      DateTime @default(now()) @map("created_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_files")
}

model Cart {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId     String @map("cart_id") @db.Uuid
  medicineId String @map("medicine_id") @db.Uuid
  quantity   Int

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])

  @@unique([cartId, medicineId])
  @@map("cart_items")
}

model Order {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  status         OrderStatus   @default(pending)
  paymentStatus  PaymentStatus @default(unpaid) @map("payment_status")
  prescriptionId String?       @map("prescription_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id])
  prescription Prescription? @relation(fields: [prescriptionId], references: [id])
  items        OrderItem[]
  payment      Payment?

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  medicineId      String  @map("medicine_id") @db.Uuid
  quantity        Int
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])

  @@map("order_items")
}

model Payment {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String              @unique @map("order_id") @db.Uuid
  bkashPaymentId String              @unique @map("bkash_payment_id")
  transactionId  String              @unique @map("transaction_id")
  amount         Decimal             @db.Decimal(10, 2)
  status         PaymentRecordStatus @default(initiated)
  createdAt      DateTime            @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([bkashPaymentId])
  @@map("payments")
}
